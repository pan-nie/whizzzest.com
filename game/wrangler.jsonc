{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "whizzzest-game",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "routes": [
    { "pattern": "game.whizzzest.com", "custom_domain": true }
  ]
}
